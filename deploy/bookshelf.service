[Unit]
Description=Bookshelf Service (Gunicorn)
# Start only after the network and PostgreSQL are ready
After=network.target postgresql.service
Wants=postgresql.service

[Service]
# ── Identity ─────────────────────────────────────────────────────────────────
# Run as a dedicated non-root user for safety.
# Create with: sudo useradd --system --no-create-home --shell /usr/sbin/nologin bookshelf
User=bookshelf
Group=bookshelf

# ── Paths ────────────────────────────────────────────────────────────────────
# Adjust REPO_PATH to where your repo lives on the VM, e.g. /srv/bookshelf
WorkingDirectory=/srv/bookshelf

# ── Environment ──────────────────────────────────────────────────────────────
# Load secrets from the .env file sitting next to app.py
EnvironmentFile=/srv/bookshelf/.env

# ── Process ──────────────────────────────────────────────────────────────────
# Bind to a Unix socket instead of a TCP port.
# Nginx will proxy to this socket (faster and safer than TCP).
ExecStart=/srv/bookshelf/venv/bin/gunicorn \
    --workers 2 \
    --bind unix:/run/bookshelf/bookshelf.sock \
    --access-logfile /var/log/bookshelf/access.log \
    --error-logfile  /var/log/bookshelf/error.log \
    --capture-output \
    --timeout 30 \
    app:app

# ── Runtime directory (systemd creates /run/bookshelf automatically) ──────────
RuntimeDirectory=bookshelf
RuntimeDirectoryMode=0750

# ── Restart policy ───────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The service needs write access only to its log dir and the runtime socket dir
ReadWritePaths=/var/log/bookshelf /run/bookshelf

[Install]
WantedBy=multi-user.target

