[Unit]
Description=Bookshelf Service (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
# ── Identity ──────────────────────────────────────────────────────────────────
User=bookshelf
Group=bookshelf

# ── Paths ─────────────────────────────────────────────────────────────────────
WorkingDirectory=/srv/bookshelf

# ── Environment ───────────────────────────────────────────────────────────────
# Override HOME — the bookshelf system user has no /home/bookshelf directory.
# Without this, Gunicorn's control server errors with "Permission denied: /home/bookshelf"
Environment=HOME=/srv/bookshelf
EnvironmentFile=/srv/bookshelf/.env

# ── Process ───────────────────────────────────────────────────────────────────
# --umask 007 → socket created as 0660 (bookshelf:bookshelf rw-rw----)
# www-data reaches it because we add www-data to the bookshelf group (see DEPLOY.md)
ExecStart=/srv/bookshelf/venv/bin/gunicorn \
    --workers 2 \
    --bind unix:/run/bookshelf/bookshelf.sock \
    --umask 007 \
    --access-logfile /var/log/bookshelf/access.log \
    --error-logfile  /var/log/bookshelf/error.log \
    --capture-output \
    --timeout 30 \
    app:app

# ── Runtime directory ─────────────────────────────────────────────────────────
# systemd creates /run/bookshelf at start and removes it on stop.
# 0770 → bookshelf:bookshelf can enter; www-data can too (after group add below)
RuntimeDirectory=bookshelf
RuntimeDirectoryMode=0770

# ── Restart policy ────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s

# ── Hardening ─────────────────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/log/bookshelf /run/bookshelf

[Install]
WantedBy=multi-user.target

