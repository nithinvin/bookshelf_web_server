# ─────────────────────────────────────────────
#  .env.example  –  copy to .env and fill in
#  Do NOT commit .env to version control
# ─────────────────────────────────────────────

# Flask
FLASK_APP=app.py
FLASK_ENV=development          # change to "production" on Hetzner
SECRET_KEY=change-me-to-a-long-random-string
FORCE_HTTPS=false              # set to true once HTTPS is confirmed working

# Admin — used by deploy/setup_https.sh for Let's Encrypt renewal alerts.
# Set this in .env on the VM only. Do NOT commit a real email to the repo.
ADMIN_EMAIL=you@example.com

# hCaptcha — get both keys from https://dashboard.hcaptcha.com
# Site key   : goes in the HTML (public, safe to expose)
# Secret key : stays on the server only, never commit this
HCAPTCHA_SITE_KEY=your-site-key-here
HCAPTCHA_SECRET_KEY=your-secret-key-here

# Google OAuth — from https://console.cloud.google.com
# Both values come from your OAuth 2.0 Client ID credentials page.
# Never commit the real values — set them only in .env on the VM.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mvp_db
DB_USER=mvp_user
DB_PASSWORD=your_db_password_here
